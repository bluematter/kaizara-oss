# Postgres connection string (local example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaizara?schema=public"

# Auth.js. Generate your own: openssl rand -base64 32
AUTH_SECRET="replace-with-your-own-random-string"
AUTH_URL="http://localhost:3001"

# fal.ai key. Needed only for the AI chat and lab PDF parsing
FAL_KEY=""

# Public base URL used in canonical links, sitemap and robots
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Set to "true" to show the demo login hint
NEXT_PUBLIC_DEMO_MODE="true"

# Required to run `npm run db:seed` (dev databases only)
ALLOW_SEED=""
